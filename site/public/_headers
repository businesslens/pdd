# Cloudflare Pages response headers for the generated site. Pages, feeds and
# Blueprint data keep Cloudflare's default revalidation, so a deploy is visible
# at once.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Build output is content-hashed, so a changed file has a new name.
/_nuxt/*
  Cache-Control: public, max-age=31536000, immutable

# Blueprint logos and covers come from contributions. Opened directly, they
# must not run scripts or load anything.
/_blueprints/*
  Content-Security-Policy: default-src 'none'; script-src 'none'; style-src 'none'; img-src 'none'; connect-src 'none'; sandbox
