+++ b/layers/nuxt/report-viewer/app/utils/experienceVariants.ts
@@ -0,0 +1,10 @@
+import type { AnyResourceView, ExperienceView, ReportWorkspace } from './reportWorkspace'
+
+/** Peer membership derives only from explicit links, never similar names. */
+export function concurrentVariants(workspace: ReportWorkspace, resource: AnyResourceView): ExperienceView[] {
+  if (resource.kind !== 'experience') return []
+  const anchor = resource.variantOfId ?? resource.id
+  return workspace.experiences.filter(item => item.id !== resource.id
+    && (item.id === anchor || item.variantOfId === anchor))
+}
+
diff --git a/src/core/experience-variants.ts b/src/core/experience-variants.ts
new file mode 100644
index 0000000..3f03821
--- /dev/null
+++ b/src/core/experience-variants.ts
@@ -0,0 +1,13 @@
+import { interfaceOf, isQualifiedId } from './ids.js'
+
+/** A variant link groups current alternatives; it never supplies containment or inheritance. */
+export function experienceVariantIssues(id: string, targetId: string | null, experiences: ReadonlyMap<string, { variantOf: string | null }>): string[] {
+  if (targetId === null) return []
+  if (!isQualifiedId(targetId) || targetId.split('::').length !== 2) return ['variantOf must name a full qualified Experience id']
+  if (id === targetId) return ['variantOf cannot name itself']
+  const target = experiences.get(targetId)
+  if (!target) return [`variantOf references missing Experience "${targetId}"`]
+  if (interfaceOf(id) !== interfaceOf(targetId)) return ['variantOf must name an Experience in the same Interface']
+  if (target.variantOf !== null) return ['variantOf cannot form a chain or cycle; the target must be an unlinked anchor']
+  return []
+}
diff --git a/test/experience-variants.test.ts b/test/experience-variants.test.ts
new file mode 100644
index 0000000..0f29667
--- /dev/null
+++ b/test/experience-variants.test.ts
@@ -0,0 +1,118 @@
+import { mkdtempSync, readFileSync, rmSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { afterEach, describe, expect, it } from 'vitest'
+import { compileReport } from '../src/commands/export.js'
+import { lintModel } from '../src/commands/lint.js'
+import { expandProductReport } from '../src/commands/open.js'
+import { loadModel } from '../src/core/model.js'
+import { ProductReportV15Schema, validateProductReport } from '../src/core/portable.js'
+
+const utility = (name: string) => import(`../layers/nuxt/report-viewer/app/utils/${name}.ts`)
+const { projectReportWorkspace } = await utility('reportWorkspace')
+const { concurrentVariants } = await utility('experienceVariants')
+const { resourceConnectionRows } = await utility('resourceConnections')
+const { tabsFor } = await utility('pageSections')
+const { structureChildren, insideSummary } = await utility('collectionChildren')
+const ROOT = join(__dirname, '..', 'blueprints/content-feed-reader')
+const ANCHOR = 'reader-mobile::personal-library'
+const VARIANT = 'reader-mobile::source-focused-library'
+const dirs: string[] = []
+afterEach(() => { for (const dir of dirs.splice(0)) rmSync(dir, { recursive: true, force: true }) })
+const model = () => loadModel(ROOT)
+const report = () => compileReport(model(), '2026-09-26')
+
+describe('concurrent Experience variants', () => {
+  it('round-trips the relationship and selection Rule without inheriting content', () => {
+    const original = report()
+    expect(validateProductReport(original)).toEqual([])
+    expect(original.model.experiences.find(e => e.id === VARIANT)!.variantOfId).toBe(ANCHOR)
+    const target = mkdtempSync(join(tmpdir(), 'bl-variants-')); dirs.push(target)
+    expandProductReport(target, original, false)
+    const loaded = loadModel(target)
+    expect(lintModel(loaded, []).errors).toEqual([])
+    expect(loaded.experiences.find(e => e.id === VARIANT)!.variantOf).toBe(ANCHOR)
+    const anchorFile = join(target, '.businesslens/interfaces/reader-mobile/experiences/personal-library/experience.md')
+    expect(readFileSync(anchorFile, 'utf8')).not.toContain('variantOf:')
+    const again = compileReport(loaded, '2026-09-26')
+    expect(again.model.experiences).toEqual(original.model.experiences)
+    expect(again.model.businessRules).toEqual(original.model.businessRules)
+    expect(again.model.capabilities).toEqual(original.model.capabilities)
+  })
+
+  it.each([
+    ['', 'full qualified Experience id'],
+    ['personal-library', 'full qualified Experience id'],
+    ['reader-mobile::missing', 'missing Experience'],
+    [VARIANT, 'cannot name itself'],
+    ['reader-web::personal-library', 'same Interface'],
+    ['reader-mobile::personal-library::unread-library', 'full qualified Experience id']
+  ])('rejects invalid target %s in authored and portable models', (target, message) => {
+    const loaded = model()
+    loaded.experiences.find(e => e.id === VARIANT)!.variantOf = target
+    expect(lintModel(loaded, []).errors.join('\n')).toContain(message)
+    const wire = report()
+    wire.model.experiences.find(e => e.id === VARIANT)!.variantOfId = target
+    // Malformed ids can be rejected by the wire schema before relationship validation.
+    if (ProductReportV15Schema.safeParse(wire).success) expect(validateProductReport(wire).join('\n')).toContain(message)
+    else expect(validateProductReport(wire).length).toBeGreaterThan(0)
+  })
+
+  it('rejects chains and cycles without choosing a winning anchor', () => {
+    const loaded = model()
+    const alternative = loaded.experiences.find(e => e.id === VARIANT)!
+    loaded.experiences.push({ ...alternative, id: 'reader-mobile::third', variantOf: VARIANT })
+    expect(lintModel(loaded, []).errors.join('\n')).toContain('chain or cycle')
+    const wire = report()
+    wire.model.experiences.find(e => e.id === ANCHOR)!.variantOfId = VARIANT
+    expect(validateProductReport(wire).join('\n')).toContain('chain or cycle')
+  })
+
+  it('requires an explicit nullable link on the wire and rejects a deleted anchor', () => {
+    const wire = report()
+    delete (wire.model.experiences.find(e => e.id === VARIANT)! as Partial<typeof wire.model.experiences[number]>).variantOfId
+    expect(ProductReportV15Schema.safeParse(wire).success).toBe(false)
+    const loaded = model()
+    loaded.experiences = loaded.experiences.filter(e => e.id !== ANCHOR)
+    expect(lintModel(loaded, []).errors.join('\n')).toContain('variantOf references missing Experience')
+  })
+
+  it('justifies same-audience same-access Experiences without counterparts', () => {
+    const loaded = model()
+    const source = loaded.experiences.find(e => e.id === ANCHOR)!
+    loaded.interfaces.push({ ...loaded.interfaces.find(i => i.id === 'reader-mobile')!, id: 'trial', entryPoints: [], navigation: [] })
+    loaded.experiences.push(
+      { ...source, id: 'trial::a', interface: 'trial', entryPoints: [], navigation: [] },
+      { ...source, id: 'trial::b', interface: 'trial', entryPoints: [], navigation: [], variantOf: 'trial::a' }
+    )
+    expect(lintModel(loaded, []).errors).toEqual([])
+    loaded.experiences.find(e => e.id === 'trial::b')!.variantOf = null
+    expect(lintModel(loaded, []).errors.join('\n')).toContain('none is a counterpart or Variation')
+  })
+
+  it('derives symmetric peer links in the list and drilldown without changing containment', () => {
+    const workspace = projectReportWorkspace(report())
+    const a = workspace.experiences.find((e: any) => e.id === ANCHOR)
+    const b = workspace.experiences.find((e: any) => e.id === VARIANT)
+    expect(concurrentVariants(workspace, a).map((e: any) => e.id)).toEqual([VARIANT])
+    expect(concurrentVariants(workspace, b).map((e: any) => e.id)).toEqual([ANCHOR])
+    const iface = workspace.interfaces.find((item: any) => item.id === 'reader-mobile')
+    const group = structureChildren(workspace, iface).find((node: any) => node.groupKind === 'experience')
+    expect(group.children.map((node: any) => node.resource.id)).toEqual([ANCHOR, VARIANT])
+    for (const node of group.children) {
+      const peer = node.resource.id === ANCHOR ? VARIANT : ANCHOR
+      expect(node.alternatives.map((item: any) => item.id)).toEqual([peer])
+      expect(node.children.some((child: any) => child.resource?.id === peer)).toBe(false)
+      expect(insideSummary(node).some((count: any) => count.kind === 'experience')).toBe(false)
+    }
+    for (const experience of [a, b]) {
+      expect(tabsFor(workspace, experience).find((tab: any) => tab.id === 'overview').blocks).toContain('variants')
+      expect(tabsFor(workspace, experience).some((tab: any) => tab.id === 'rules')).toBe(true)
+      expect(resourceConnectionRows(workspace, experience).some((row: any) => row.label === 'variation of')).toBe(true)
+    }
+    const before = b.capabilityIds
+    a.capabilityIds = []
+    expect(b.capabilityIds).toEqual(before)
+    expect(concurrentVariants(workspace, workspace.experiences.find((e: any) => e.id === 'reader-web::personal-library'))).toEqual([])
+  })
+})
