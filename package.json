{
  "name": "businesslens",
  "version": "0.8.0",
  "description": "Product-Driven Development for coding agents: a git-tracked Product Model in .businesslens/, verified against implementation.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/businesslens/pdd.git"
  },
  "homepage": "https://github.com/businesslens/pdd#readme",
  "bugs": {
    "url": "https://github.com/businesslens/pdd/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "workspaces": [
    "viewer/app"
  ],
  "bin": {
    "businesslens": "dist/cli.js"
  },
  "exports": {
    "./report": {
      "types": "./dist/report.d.ts",
      "default": "./dist/report.js"
    },
    "./report/digest": {
      "types": "./dist/report-digest.d.ts",
      "default": "./dist/report-digest.js"
    },
    "./logo": {
      "types": "./dist/logo.d.ts",
      "default": "./dist/logo.js"
    },
    "./nuxt/report-viewer": "./layers/nuxt/report-viewer/nuxt.config.ts",
    "./nuxt/theme": "./layers/nuxt/theme/nuxt.config.ts",
    "./nuxt/theme-lab": "./layers/nuxt/theme-lab/nuxt.config.ts",
    "./theme-lab/variants": {
      "types": "./dist/businesslensThemeLabVariants.d.ts",
      "default": "./dist/businesslensThemeLabVariants.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "docs",
    "layers",
    "!layers/nuxt/workbench-lab",
    "plans/shared-theme-lab.md",
    "skills"
  ],
  "scripts": {
    "build": "npm run build:core && npm run build:viewer",
    "build:core": "tsdown",
    "build:viewer": "npm run build --workspace @businesslens/local-report-viewer && node scripts/copy-viewer.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:unlink": "node scripts/dev.mjs --unlink",
    "typecheck": "tsc --noEmit",
    "typecheck:viewer": "npm run typecheck --workspace @businesslens/local-report-viewer",
    "test": "vitest run",
    "package:size": "node scripts/check-package-size.mjs",
    "theme:icons": "node scripts/build-theme-icons.mjs",
    "blueprints:check": "node scripts/blueprints-check.mjs",
    "blueprints:publish": "node scripts/blueprints-publish.mjs",
    "check": "node scripts/check-repo.mjs",
    "verify": "npm run typecheck && npm run typecheck:viewer && npm run build && npm run package:size && npm test && npm run check && npm run blueprints:check",
    "version": "node scripts/sync-version.mjs",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "commander": "^14.0.3",
    "saxes": "^6.0.0",
    "yaml": "^2.6.0",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@iconify-json/lucide": "^1.2.111",
    "@nuxt/ui": "^4.9.0",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.0",
    "@vue-flow/minimap": "^1.5.4",
    "nuxt": "^4.4.0",
    "tailwindcss": "^4.3.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@dagrejs/dagre": {
      "optional": true
    },
    "@fontsource-variable/archivo": {
      "optional": true
    },
    "@fontsource-variable/inter": {
      "optional": true
    },
    "@fontsource/ibm-plex-mono": {
      "optional": true
    },
    "@iconify-json/lucide": {
      "optional": true
    },
    "@nuxt/ui": {
      "optional": true
    },
    "@vue-flow/background": {
      "optional": true
    },
    "@vue-flow/controls": {
      "optional": true
    },
    "@vue-flow/core": {
      "optional": true
    },
    "@vue-flow/minimap": {
      "optional": true
    },
    "nuxt": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@playwright/test": "1.61.1",
    "tsdown": "^0.12.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "overrides": {
    "rolldown": "1.0.0-beta.19"
  }
}
